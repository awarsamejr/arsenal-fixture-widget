{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matchnight",
  "mainBinaryName": "matchnight",
  "version": "3.0.0",
  "identifier": "com.awarsamejr.matchnight",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Matchnight",
        "width": 380,
        "height": 600,
        "minWidth": 340,
        "minHeight": 460,
        "decorations": false,
        "shadow": true,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://crests.football-data.org data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Matchnight",
    "longDescription": "Your team's fixtures, live scores, stats, table and match reminders on your desktop.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
